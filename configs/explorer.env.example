# Explorer environment file -- TEMPLATE. Never commit a filled-in copy.
#
#   cp configs/explorer.env.example configs/explorer.env      (the local copy is ignored by git)
#   chmod 600 configs/explorer.env                             (it holds a shared secret)
#   python tools/check_config.py                               (reports every <...> still unfilled)
#
# Use it with:  docker run --env-file configs/explorer.env ...   or a systemd  EnvironmentFile=
# Reference for every variable: doc/aps_explorer.md ("Environment variable reference").
# Replace each <...> placeholder; delete lines for features you do not use.

# Isolated browser sessions (recommended for any shared server): 1 = on
PYAPS_EXPLORER_MULTI_SESSION=1

# Only a signed token from a trusted upstream app may load a dataset: 1 = on (needs the secret below)
PYAPS_EXPLORER_REQUIRE_WEAVEOR_AUTH=0

# HMAC secret shared with the token-issuing app. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a different secret for every environment (dev and prod must not share one).
PYAPS_EXPLORER_WEAVEOR_SECRET=<long random secret shared with the token-issuing app>

# Where "back to the upstream app" links point for a locked session (leave out if unused)
PYAPS_EXPLORER_WEAVEOR_URL=<https URL of the upstream app>

# Seconds a handoff token stays valid
PYAPS_EXPLORER_WEAVEOR_TOKEN_MAX_AGE=300

# Mount the app under a sub-path of a shared reverse-proxied host (leave out to serve from the host root)
PYAPS_EXPLORER_URL_PREFIX=<sub-path such as weave, or remove this line>

# Deployment-wide fallback calibration / catalogue folders, as seen by the server process
PYAPS_EXPLORER_DEFAULT_CALDIR=<calibration folder>
PYAPS_EXPLORER_DEFAULT_CATDIR=<catalogue folder>

# Writable, persistent config/cache folder (needed when configs/ExGal_configs is not shipped)
PYAPS_CONFIGDIR=<writable config and cache folder>

# Session housekeeping (defaults shown)
PYAPS_EXPLORER_IDLE_TIMEOUT_MINUTES=10
PYAPS_EXPLORER_SESSION_TTL_SECONDS=14400
