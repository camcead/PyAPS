# =====================================================================================================
# script_params.yaml.example  --  TEMPLATE. Do not edit in place and never commit a filled-in copy.
#
# First-time setup:   cp configs/script_params.yaml.example configs/script_params.yaml
#                     (edit the local copy; it is ignored by git)  then check it with
#                     python tools/check_config.py
#
# Every value below is either a documented default or a placeholder you must replace:
#   * ${PYAPS_HOME}        root of your PyAPS working tree (export PYAPS_HOME=...; see README, "Environment variables")
#   * ${PYAPS_PKG_DIR}     folder with the aps_*.py modules (set automatically by aps_runner)
#   * <...>                a value that has no default: replace it, the checker reports every one left
#   * <env_suffix>         environment suffix of the data trees: EMPTY for the production environment, `_dev` for the
#                          development environment (data trees L1_dev, L2_dev, CS_dev, CAT_dev, CAL_dev, XML_dev next to
#                          the production ones). Replace it in every key that has it; never point dev at the prod trees.
# Pass the local file to the runner with  --config_file configs/script_params.yaml
# Section banners (####) and the comments above a key explain what to enter; booleans/numbers are quoted
# strings on purpose (the runner converts them).
# =====================================================================================================

# General PARAMS
PyAPS_DIR: '${PYAPS_PKG_DIR}'
PyAPS_RES: '${PYAPS_HOME}/PyAPS_data/L2<env_suffix>'
CS_RES: '${PYAPS_HOME}/PyAPS_data/CS<env_suffix>'
PyAPS_CAT: '${PYAPS_HOME}/PyAPS_data/CAT<env_suffix>'
PyAPS_CAL: '${PYAPS_HOME}/PyAPS_data/CAL<env_suffix>'
PyAPS_XML: '${PYAPS_HOME}/PyAPS_data/XML<env_suffix>'
PyAPS_CONFIG: '${PYAPS_HOME}/configs'
PyAPS_EXGALCONFIG: '${PYAPS_HOME}/configs/ExGal_configs'
templates_RR: '${PYAPS_HOME}/PyAPS_templates/templates_RR'
templates_ARC_RR: '${PYAPS_HOME}/PyAPS_templates/templates_ARC_RR'
templates_RVS: '${PYAPS_HOME}/PyAPS_templates/templates_RVS'
templates_FR: '${PYAPS_HOME}/PyAPS_templates/templates_FR'
templates_ExGal: '${PYAPS_HOME}/PyAPS_templates/templates_ExGal'
# Optional: file that receives one ERROR line for every job of an OB that ends FAILED, TIMEOUT, CANCELLED or
# out of memory (job id, job name, exit code, path of its .err file). Use the log file of your WDAP runner
# so SLURM failures show up there; 'None' = off (the failure then only shows in the job's own .err file).
runner_log: 'None'
fsuffix: '.fits'
aps_suffix: '_APS'
kiko_script_name: 'PyAPS_bash.sh'
slurm_script_name: 'PyAPS_slurm.sh'

CS_kiko_script_name: 'CS_bash.sh'
CS_slurm_script_name: 'CS_slurm.sh'

########### VENV mode ############

use_venv: 'False'
venv_path: '$HOME/venv/bin/activate'

############ MOS MODE ############

# CLASS PARAMS
join_arms_RR: 'False'
pref_RR: 'zbest_'
config_RR: 'weave_cls.json'
zall_RR: 'True'
priors_RR: 'None'
chi2_scan_RR: 'None'
nminima_RR: '3'
cache_Rcsr_RR: 'False'
debug_RR: 'False'
overwrite_RR: 'True'
fig_RR: 'True'
sens_corr_RR: 'True'
mask_gaps_RR: 'True'
safe_mask_gaps_RR: 'True'
tellurics_RR: 'False'
vacuum_RR: 'True'
fill_gap_RR: 'False'
ntop_RR: '3'

#RVS PARAMS
join_arms_RVS: 'False'
pref_RVS: 'rvs_'
config_RVS: '${PYAPS_HOME}/configs/rvs_config.yaml'
outspec_RVS: 'True'
overwrite_RVS: 'True'
fig_RVS: 'True'
sens_corr_RVS: 'True'
mask_gaps_RVS: 'True'
safe_mask_gaps_RVS: 'True'
tellurics_RVS: 'True'
vacuum_RVS: 'False'
fill_gap_RVS: 'True'
# Device for the RVS neural-net interpolator ('cpu', 'gpu' or 'auto'). Defaults to 'cpu':
# batch jobs normally have no GPU allocation and the model's baked-in 'cuda' device
# would crash them; see aps_rvs.py's resolve_rvs_device()/--device.
device_RVS: 'cpu'

# FERRE PARAMS
FERRE_EXE: '${PYAPS_HOME}/externals/ferre/bin/ferre.x'
MOS_Gal_grid_prefix_FR: 'm'
join_arms_FR: 'False'
pref_FR: 'ferre_'
outspec_FR: 'True'
fig_FR: 'True'
sens_corr_FR: 'True'
mask_gaps_FR: 'True'
safe_mask_gaps_FR: 'True'
tellurics_FR: 'True'
vacuum_FR: 'False'
fill_gap_FR: 'False'
grid_ids_FR: '1,2,3,4,5,6,7,8,9'
mask_balmer_FR: 'True'
use_linemasks_FR: 'False'
linemask_FR: '${PYAPS_HOME}/configs/ferre_linemasks/mask_APS_state_20260615.csv'

#EXGAL PARMS
join_arms_ExGal: 'True'
fig_ExGal: 'True'
sens_corr_ExGal: 'True'
mask_gaps_ExGal: 'True'
safe_mask_gaps_ExGal: 'True'
tellurics_ExGal: 'False'
vacuum_ExGal: 'False'
fill_gap_ExGal: 'False'
EMIPPXF_LEVEL_ExGal: 'BIN'
LS_RES_ExGal: 'ADAPTED'
LS_MODE_ExGal: '1'
RUN_PPXF: 'True'
RUN_EMIPPXF: 'True'
RUN_LS: 'True'


############ IFU MODE ############

IFU_templates_CLASS_PCA: '${PYAPS_HOME}/PyAPS_templates/templates_RR'
IFU_templates_CLASS_ARC: '${PYAPS_HOME}/PyAPS_templates/templates_ARC_RR'
IFU_RUN_PPXF: 'True'
IFU_RUN_EMIPPXF: 'True'
IFU_RUN_LS: 'True'
IFU_sens_corr: 'True'
IFU_mask_gaps: 'True'
IFU_safe_mask_gaps: 'True'
IFU_tellurics: 'False'
IFU_vacuum: 'False'
IFU_fill_gap: 'False'
IFU_join_arms: 'True'
IFU_fig: 'True'
IFU_Gal_run: 'True'
IFU_ExGal_run: 'True'
seg2d: 'True'
seg2d_white_src: 'weave'
seg2d_search_gaia: 'False'
seg2d_extract: 'True'
seg2d_exclude_ctarg: 'True'
seg2d_mask_stars: 'False'
seg2d_ext_thresh: '2.5'
seg2d_minarea: '300'
seg2d_deblend_nthresh: '4'
seg2d_radii_factor: '8.0'
# seg3d: optional 3D matched-filter emission-line detection, additive to seg2d
# (see doc/aps_ifu_prepare.md). Both default False -- 2D SExtractor remains the
# default/only detection method unless explicitly enabled here.
seg3d: 'False'
# seg3d_lmin/lmax: default here is the LOWRES (LIFULR/MIFULR) blue+red
# combined native wavelength coverage (measured from real L1 headers:
# blue 3600-5955A, red 5820-9490A), trimmed by ~100A at each end (worse
# flat-fielding/wavelength-solution reliability right at an arm's true
# edge). HIGHRES (LIFUHR/MIFUHR) surveys override this via their own
# IFU_params JSON (measured HR coverage: blue 4695-5505A, red 5930-6840A,
# with a real gap between the two arms -- load_wavelength_range/mask_gaps
# handles that gap automatically) -- see doc/aps_ifu_prepare.md.
seg3d_lmin: '3700.0'
seg3d_lmax: '9390.0'
seg3d_threshold: '6.0'
seg3d_spatial_bin: '4'
seg3d_continuum_method: 'pca'
seg3d_ivar_calibration: 'per-wave'
seg3d_fig: 'True'
seg3d_min_npix: '3'
# seg3d_merge: auto-merge 'obvious' (SNR >= seg3d_merge_min_snr) 3D-only
# candidates into the real patch table (_targets.fits) as additional type='T'
# targets, marked with flag=3 for provenance. Requires seg2d=True and seg3d=True.
seg3d_merge: 'False'
seg3d_merge_min_snr: '15.0'
# seg3d_merge_group_*: an ADDITIONAL, independent path into seg3d_merge --
# a candidate with >= seg3d_merge_group_min_lines OTHER no-continuum-
# counterpart candidates at the exact same detection-grid pixel (different
# wavelengths, i.e. plausibly several lines of one source) is merged if the
# group's COMBINED significance (quadrature sum over every member's S/N,
# not just its strongest) clears a field-calibrated threshold floored at
# seg3d_merge_group_min_snr (see aps_ifu_seg3d.py's merge_into_patch_table
# / resolve_group_min_snr and doc/aps_ifu_prepare.md). Does not check
# redshift consistency -- that is left to the Redrock pass every merged
# target already goes through. Set seg3d_merge_group_min_lines: 'None' to
# disable this path.
seg3d_merge_group_min_lines: '3'
seg3d_merge_group_min_snr: '15.0'
seg3d_merge_group_min_n_trust: '3'
seg3d_group_radius_px: '0.0'
# seg3d_merge_extreme_safety_margin: THIRD independent seg3d_merge path,
# for an extreme-S/N singleton neither the single-line ratio path nor the
# multi-line grouping path can certify (e.g. a very high S/N candidate with
# no corroborating line, at a field where the purity self-check never gets
# measured with enough samples that high). Compares the candidate's S/N to
# the single loudest fluctuation the full sign-flipped search ever produced
# (aps_ifu_seg3d.loudest_event_snr / resolve_extreme_snr_min), requiring it
# to clear that loudest event by this safety margin (10% by default). Set
# to 'None' to disable this path.
seg3d_merge_extreme_safety_margin: '1.2'
class_patch: 'True'
class_z_rad: '2.5'
class_ntop: '3'
user_patch: 'False'



